{
  "name": "RIS HR - Groq Multi-Agent Candidate Evaluation & AI SOP Detector",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "evaluate-candidate",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GROQ_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\"role\": \"user\", \"content\": \"Perform Multi-Agent Evaluation on candidate ID: {{ $json.body.candidate_id }}\"}\n  ],\n  \"response_format\": {\"type\": \"json_object\"}\n}"
      },
      "name": "Groq Multi-Agent LLM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [500, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Groq Multi-Agent LLM",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
