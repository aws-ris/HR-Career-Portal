# Database Connection URL (PostgreSQL in production, SQLite in local dev)
DATABASE_URL=sqlite:///./ris_dev.db

# HR Admin Login Credentials
HR_ADMIN_USERNAME=hr_ris
HR_ADMIN_PASSWORD=ris@1234

# AWS S3 Configuration (Optional - defaults to local DB blob / file storage if unset)
S3_BUCKET_NAME=ris-hr-portal-resumes-prod
AWS_REGION=ap-south-1

# n8n Automation Webhook Configuration
N8N_WEBHOOK_URL=https://n8n.ris-tms.org/webhook
N8N_SECRET_TOKEN=

# Security & CORS Settings
JWT_SECRET=production_jwt_secret_key_12345
ALLOWED_ORIGINS=*
